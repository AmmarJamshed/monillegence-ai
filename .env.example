# Monillegence AI — Environment Configuration
# Copy to .env and adjust as needed

# Agent backend
MONILLEGENCE_AGENT_PORT=9477
MONILLEGENCE_AGENT_HOST=127.0.0.1
MONILLEGENCE_DATA_DIR=

# Runtime ports (defaults)
OLLAMA_HOST=127.0.0.1:11434
LMSTUDIO_PORT=1234
LLAMACPP_PORT=8080

# Preferred runtime: ollama | lmstudio | llamacpp | auto
MONILLEGENCE_PREFERRED_RUNTIME=auto

# Model routing
MONILLEGENCE_DEFAULT_STARTER_MODEL=qwen2.5-coder:7b

# Parallel build workers (default: half your CPU cores, max 4)
MONILLEGENCE_PARALLEL_WORKERS=

# Auto-build without approval prompts (default: true)
MONILLEGENCE_AUTO_BUILD=true

# Safety — set false only for manual approval on file writes
MONILLEGENCE_REQUIRE_APPROVAL=true

# Localization
MONILLEGENCE_DEFAULT_LOCALE=en

# Development
NODE_ENV=development
MONILLEGENCE_DEV_OPEN_DEVTOOLS=true
